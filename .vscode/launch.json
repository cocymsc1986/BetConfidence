{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend (FastAPI)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      // No --reload: it runs the app in a child process, which breaks breakpoints.
      // Restart with Ctrl+Shift+F5 after editing backend code.
      "args": ["backend.main:app", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true,
      "preLaunchTask": "Check setup"
    },
    {
      "name": "Frontend (Vite)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/frontend",
      "serverReadyAction": {
        // Vite colours the port with escape codes, so match the ready line and use the
        // fixed port from vite.config.js rather than parsing the URL.
        "pattern": "ready in",
        "uriFormat": "http://localhost:5173",
        "action": "openExternally"
      }
    },
    {
      "name": "Tests (pytest)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["backend/tests", "-q"],
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    }
  ],
  "compounds": [
    {
      "name": "Pitch Edge: full stack",
      "configurations": ["Backend (FastAPI)", "Frontend (Vite)"],
      "stopAll": true
    }
  ]
}
