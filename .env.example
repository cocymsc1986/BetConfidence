# Pitch Edge configuration. Copy to .env and fill in your keys.
API_FOOTBALL_KEY=
ODDS_API_KEY=
API_FOOTBALL_HOST=v3.football.api-sports.io
# Comma-separated league ids.
# Clubs:        39=EPL, 40=Championship, 140=La Liga, 135=Serie A, 78=Bundesliga, 61=Ligue 1,
#               2=Champions League, 3=Europa League
# Internationals: 1=FIFA World Cup, 4=UEFA Euro, 5=UEFA Nations League,
#                 9=Copa America, 13=CONMEBOL Libertadores, 15=FIFA Club World Cup
# Internationals use the tournament year (e.g. World Cup 2026 = season 2026);
# club leagues use the active Aug-May season automatically.
# Don't know an ID? GET /leagues/discover?q=world+cup
TARGET_LEAGUES=39
# Optional: season override (applies to ALL leagues if set; usually unwanted).
# API_FOOTBALL_SEASON=2025

# Recent matches per team (all competitions) pulled when you click Analyse.
HISTORY_MATCHES=20
# Seconds between API-Football calls. Free plan ~10/min -> use 6; Pro can use 0.25.
API_FOOTBALL_MIN_INTERVAL=0.25

# Bookmakers whose prices count as "best odds" (the ones you have accounts with).
# All fetched bookmakers (incl. Pinnacle) still feed the market-consensus probability.
# Leave empty to allow every bookmaker.
ODDS_BOOKMAKERS=bet365,williamhill,paddypower,skybet,betfair,ladbrokes,coral,unibet,betway,betvictor

# The Odds API: regions and per-event markets (each market x region costs 1 credit per analysis).
ODDS_API_REGIONS=uk,eu
ODDS_API_EVENT_MARKETS=btts,alternate_totals,alternate_totals_corners,alternate_totals_cards,player_goal_scorer_anytime,player_shots_on_target,player_shots,player_to_receive_card,player_assists
