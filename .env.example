# Pitch Edge configuration. Copy to .env and fill in your keys.
API_FOOTBALL_KEY=
ODDS_API_KEY=
API_FOOTBALL_HOST=v3.football.api-sports.io
# Comma-separated league ids. 39=EPL, 140=La Liga, 135=Serie A, 78=Bundesliga, 61=Ligue 1
TARGET_LEAGUES=39
# Optional: season override. Defaults to current calendar year.
# API_FOOTBALL_SEASON=2025
